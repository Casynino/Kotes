# ============================================================================
#  KOTES (T) LIMITED — website environment configuration
# ----------------------------------------------------------------------------
#  Copy this file to `.env.local` for development, and set the same variables
#  in your hosting provider's dashboard for production.
#
#  NEVER commit `.env.local` or any file containing real credentials.
#  Only variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
# ============================================================================

# ---------------------------------------------------------------- Site ------
# Canonical origin, no trailing slash. Used for canonical URLs, sitemap,
# Open Graph tags and JSON-LD. MUST be set correctly in production.
NEXT_PUBLIC_SITE_URL=https://www.kotes.co.tz


# ---------------------------------------------------------------- Email -----
# SMTP credentials for delivering contact-form notifications.
# Without these the form still works and stores enquiries, but no email is sent
# and a loud error is written to the server log.
#
# Typical values:
#   Google Workspace : smtp.gmail.com          port 587  (use an App Password)
#   Microsoft 365    : smtp.office365.com      port 587
#   cPanel / shared  : mail.kotes.co.tz        port 465 (secure) or 587
#   Amazon SES       : email-smtp.<region>.amazonaws.com port 587
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
# Leave unset to infer: true for port 465, false otherwise.
# SMTP_SECURE=false
SMTP_USER=no-reply@kotes.co.tz
SMTP_PASSWORD=replace-with-app-password

# Envelope "From" address. Defaults to SMTP_USER when unset.
# Must be an address your SMTP provider is allowed to send as.
CONTACT_FROM_EMAIL=no-reply@kotes.co.tz

# Where enquiry notifications are delivered.
# Defaults to the address in src/content/company.ts when unset.
CONTACT_TO_EMAIL=info@kotes.co.tz

# Set Reply-To on notifications to the visitor's address so staff can reply
# straight from the inbox. Set to "false" to disable.
# CONTACT_REPLY_TO_VISITOR=true

# Send an automatic acknowledgement to the visitor. Set to "false" to disable.
# CONTACT_SEND_ACK=true


# ------------------------------------------------------------ Anti-abuse ----
# Max enquiry submissions per IP address per window.
# CONTACT_RATE_LIMIT=5
# Window length in milliseconds (default 10 minutes).
# CONTACT_RATE_WINDOW_MS=600000


# ------------------------------------------------------------- Storage ------
# Directory for the JSON inquiry store. Defaults to ./data
# Must be writable and MUST NOT be inside /public.
# INQUIRY_DATA_DIR=/var/lib/kotes/data
#
# Set to "memory" to disable disk persistence entirely (read-only hosts).
# Enquiries are then delivered by email only.
# INQUIRY_STORE=memory


# --------------------------------------------------------------- Admin ------
# Bearer token protecting GET/PATCH /api/admin/inquiries.
# Minimum 24 characters — shorter tokens make the endpoint return 404.
# Leave unset to disable the admin API completely.
# Generate one with:  openssl rand -base64 36
# ADMIN_API_TOKEN=
